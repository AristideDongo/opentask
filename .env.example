# Copiez ce fichier en `.env` puis adaptez les valeurs. Ne commitez jamais `.env`.

# URL publique de l’application (interface web ; l’API est servie sous /api sur la même origine).
PUBLIC_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://opentask:opentask@localhost:5432/opentask
# Base utilisée par `pnpm test` (créée automatiquement par docker-compose.yml)
TEST_DATABASE_URL=postgresql://opentask:opentask@localhost:5432/opentask_test

# Secret de signature des sessions : 32 caractères minimum.
# Générez-en un avec : openssl rand -base64 48
AUTH_SECRET=change-me-change-me-change-me-change-me

# Exiger la vérification de l’adresse e-mail avant la première connexion.
REQUIRE_EMAIL_VERIFICATION=false

# E-mails. En développement, Mailpit capture tout : http://localhost:8025
# Sans SMTP_URL, les liens sont écrits dans les logs (hors production).
SMTP_URL=smtp://localhost:1025
MAIL_FROM=OpenTask <no-reply@opentask.local>

# API
API_PORT=4000
LOG_LEVEL=info
# Dossier des fichiers envoyés (relatif au dossier de l’API) et taille maximale d’un fichier, en Mo.
STORAGE_DIR=storage
MAX_UPLOAD_MB=10
RATE_LIMIT_ENABLED=true
# Nombre de proxys de confiance devant l’API (reverse proxy HTTPS). 0 si l’API est exposée directement.
TRUST_PROXY_HOPS=1

# Serveur MCP en développement (`pnpm --filter @opentask/mcp dev`)
OPENTASK_API_URL=http://localhost:4000
MCP_PORT=4100
MCP_ALLOW_WRITE=true
