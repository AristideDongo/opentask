generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  locale        String   @default("fr")
  timezone      String   @default("UTC")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions            Session[]
  accounts            Account[]
  memberships         WorkspaceMember[]
  sentInvitations     Invitation[]      @relation("InvitedBy")
  acceptedInvitations Invitation[]      @relation("AcceptedBy")
  auditLogs           AuditLog[]
  createdProjects     Project[]
  createdTasks        Task[]            @relation("TaskCreator")
  comments            TaskComment[]
  createdChannels     Channel[]
  messages            Message[]
  channelReads        ChannelRead[]
  apiTokens           ApiToken[]

  uploadedAttachments Attachment[]
  messageMentions     MessageMention[]
  commentMentions     CommentMention[]

  @@map("users")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

enum WorkspaceRole {
  owner
  admin
  member
  guest
}

model Workspace {
  id        String   @id @default(uuid(7))
  name      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members     WorkspaceMember[]
  invitations Invitation[]
  auditLogs   AuditLog[]
  teams       Team[]
  projects    Project[]
  tasks       Task[]
  comments    TaskComment[]
  channels    Channel[]
  messages    Message[]

  attachments Attachment[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  teams         TeamMember[]
  channels      ChannelMember[]
  assignedTasks Task[]          @relation("TaskAssignee")

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Invitation {
  id           String        @id @default(uuid(7))
  workspaceId  String        @map("workspace_id")
  email        String        @db.VarChar(254)
  role         WorkspaceRole
  tokenHash    String        @unique @map("token_hash")
  invitedById  String?       @map("invited_by_id")
  acceptedById String?       @map("accepted_by_id")
  expiresAt    DateTime      @map("expires_at")
  acceptedAt   DateTime?     @map("accepted_at")
  revokedAt    DateTime?     @map("revoked_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy  User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User?     @relation("AcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
  @@map("invitations")
}

model AuditLog {
  id          String   @id @default(uuid(7))
  workspaceId String   @map("workspace_id")
  actorId     String?  @map("actor_id")
  action      String   @db.VarChar(64)
  targetType  String   @map("target_type") @db.VarChar(32)
  targetId    String?  @map("target_id")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorId])
  @@map("audit_logs")
}

model Team {
  id          String   @id @default(uuid(7))
  workspaceId String   @map("workspace_id")
  name        String   @db.VarChar(80)
  description String   @default("") @db.VarChar(2000)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  projects  Project[]

  @@unique([workspaceId, name])
  @@map("teams")
}

model TeamMember {
  teamId      String   @map("team_id")
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  team       Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membership WorkspaceMember @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([workspaceId, userId])
  @@map("team_members")
}

enum TaskStatus {
  todo
  in_progress
  in_review
  done
}

enum TaskPriority {
  low
  normal
  high
  urgent
}

model Project {
  id          String   @id @default(uuid(7))
  workspaceId String   @map("workspace_id")
  teamId      String?  @map("team_id")
  name        String   @db.VarChar(80)
  description String   @default("") @db.VarChar(2000)
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team      Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tasks     Task[]
  labels    ProjectLabel[]
  columns   ProjectColumn[]

  @@index([workspaceId])
  @@index([teamId])
  @@map("projects")
}

model Task {
  id          String       @id @default(uuid(7))
  workspaceId String       @map("workspace_id")
  projectId   String       @map("project_id")
  parentId    String?      @map("parent_id")
  columnId    String       @map("column_id")
  title       String       @db.VarChar(200)
  description String       @default("")
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(normal)
  dueDate     DateTime?    @map("due_date") @db.Date
  assigneeId  String?      @map("assignee_id")
  createdById String?      @map("created_by_id")
  position    Float
  completedAt DateTime?    @map("completed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column      ProjectColumn    @relation(fields: [columnId], references: [id], onDelete: NoAction)
  parent      Task?            @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]           @relation("Subtasks")
  assignee    WorkspaceMember? @relation("TaskAssignee", fields: [workspaceId, assigneeId], references: [workspaceId, userId], onDelete: NoAction)
  createdBy   User?            @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  comments    TaskComment[]
  labels      TaskLabel[]
  attachments Attachment[]

  @@index([columnId, position])
  @@index([projectId, status])
  @@index([workspaceId, assigneeId])
  @@index([parentId])
  @@map("tasks")
}

model ProjectColumn {
  id          String     @id @default(uuid(7))
  workspaceId String     @map("workspace_id")
  projectId   String     @map("project_id")
  name        String     @db.VarChar(40)
  category    TaskStatus
  position    Float
  createdAt   DateTime   @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, position])
  @@map("project_columns")
}

model ProjectLabel {
  id          String   @id @default(uuid(7))
  workspaceId String   @map("workspace_id")
  projectId   String   @map("project_id")
  name        String   @db.VarChar(40)
  color       String   @db.VarChar(7)
  createdAt   DateTime @default(now()) @map("created_at")

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   TaskLabel[]

  @@unique([projectId, name])
  @@index([workspaceId])
  @@map("project_labels")
}

model TaskLabel {
  taskId  String @map("task_id")
  labelId String @map("label_id")

  task  Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label ProjectLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
  @@map("task_labels")
}

model TaskComment {
  id          String   @id @default(uuid(7))
  workspaceId String   @map("workspace_id")
  taskId      String   @map("task_id")
  authorId    String?  @map("author_id")
  body        String   @db.VarChar(4000)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  mentions  CommentMention[]

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model Channel {
  id          String   @id @default(uuid(7))
  workspaceId String   @map("workspace_id")
  name        String   @db.VarChar(80)
  description String   @default("") @db.VarChar(2000)
  isPrivate   Boolean  @default(false) @map("is_private")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  members   ChannelMember[]
  messages  Message[]
  reads     ChannelRead[]

  @@unique([workspaceId, name])
  @@map("channels")
}

model ChannelMember {
  channelId   String   @map("channel_id")
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  channel    Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  membership WorkspaceMember @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([workspaceId, userId])
  @@map("channel_members")
}

model ChannelRead {
  channelId  String   @map("channel_id")
  userId     String   @map("user_id")
  lastReadAt DateTime @map("last_read_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@map("channel_reads")
}

model Message {
  id          String    @id @default(uuid(7))
  workspaceId String    @map("workspace_id")
  channelId   String    @map("channel_id")
  authorId    String?   @map("author_id")
  body        String    @db.VarChar(4000)
  editedAt    DateTime? @map("edited_at")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel     Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  attachments Attachment[]
  mentions    MessageMention[]

  @@index([channelId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("messages")
}

model ApiToken {
  id         String    @id @default(uuid(7))
  userId     String    @map("user_id")
  name       String
  tokenHash  String    @unique @map("token_hash")
  hint       String
  scopes     String[]
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

model Attachment {
  id           String   @id @default(uuid(7))
  workspaceId  String   @map("workspace_id")
  uploadedById String?  @map("uploaded_by_id")
  taskId       String?  @map("task_id")
  messageId    String?  @map("message_id")
  fileName     String   @map("file_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(127)
  size         Int
  isImage      Boolean  @map("is_image")
  storageKey   String   @unique @map("storage_key")
  createdAt    DateTime @default(now()) @map("created_at")

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  message    Message?  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([taskId])
  @@index([messageId])
  @@map("attachments")
}

model MessageMention {
  messageId String @map("message_id")
  userId    String @map("user_id")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
  @@map("message_mentions")
}

model CommentMention {
  commentId String @map("comment_id")
  userId    String @map("user_id")

  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_mentions")
}
