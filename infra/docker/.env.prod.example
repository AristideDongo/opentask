# Configuration de production. Copiez en `.env.prod`, ne le commitez jamais.

# URL publique (avec https:// en production).
PUBLIC_URL=https://taches.example.org
# Pour le profil `https` (Caddy) : le nom de domaine seul.
DOMAIN=taches.example.org

POSTGRES_USER=opentask
POSTGRES_DB=opentask
# openssl rand -base64 32
POSTGRES_PASSWORD=
# openssl rand -base64 48
AUTH_SECRET=

REQUIRE_EMAIL_VERIFICATION=true
# smtp://utilisateur:motdepasse@smtp.example.org:587 ou smtps://…:465
SMTP_URL=
MAIL_FROM=OpenTask <no-reply@example.org>

# Adresse publique du code source (dépôt ou archive de votre version). L’AGPL-3.0 impose
# de la proposer aux utilisateurs du service, en particulier si vous modifiez OpenTask.
SOURCE_URL=

LOG_LEVEL=info
# Taille maximale d’un fichier envoyé (images, pièces jointes), en Mo. Au-delà de 24, relevez aussi
# client_max_body_size dans infra/docker/nginx.conf.
MAX_UPLOAD_MB=10
# Proxys devant l’API : 1 (nginx du conteneur web), 2 avec le profil https (Caddy + nginx).
TRUST_PROXY_HOPS=2

# Interface exposée par le conteneur web (sans le profil https).
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Serveur MCP (assistants IA : Claude, ChatGPT). Optionnel : activé avec `--profile mcp`.
# Les écritures (créer, modifier, commenter des tâches) peuvent être désactivées ici.
MCP_ALLOW_WRITE=true
# Origines navigateur autorisées (séparées par des virgules). Vide : seuls les clients sans en-tête Origin sont acceptés.
MCP_ALLOWED_ORIGINS=
MCP_RATE_LIMIT_PER_MINUTE=120
