{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate", "db:generate"],
      "outputs": ["dist/**", "build/**"]
    },
    "db:generate": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^db:generate", "db:generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "typecheck": {
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "test": {
      "dependsOn": ["^db:generate", "db:generate"],
      "env": ["DATABASE_URL", "TEST_DATABASE_URL"],
      "cache": false
    }
  }
}
